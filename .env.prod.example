# Renombrar a .env.prod en el servidor. NUNCA commitear .env.prod.
# El script deploy/bootstrap.sh puede generar este archivo con secretos
# aleatorios automaticamente.

# Dominio publico (sin https://, sin trailing slash).
# Ejemplo gratis: pedidos-rapidos.duckdns.org
DOMAIN=cambiame.duckdns.org

# Postgres -- el usuario y password se crean en la primera corrida.
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=cambiame-en-prod
POSTGRES_DB=pedidos

# Secret para firmar JWTs. Generar con: openssl rand -hex 32
JWT_SECRET=cambiame-este-secreto-fuerte
JWT_EXPIRES_IN=12h

# ---- Super admin (dueno del sistema) --------------------------------------
# OBLIGATORIO en prod: si SUPERADMIN_PASSWORD queda en el default, el API no arranca.
SUPERADMIN_EMAIL=owner@tudominio.com
SUPERADMIN_PASSWORD=cambiame-superadmin-fuerte

# ---- Email transaccional (SMTP, OPCIONAL pero recomendado) ----------------
# Sin SMTP_HOST/SMTP_USER los emails se omiten. Cualquier proveedor SMTP sirve.
APP_NAME=Pedidos Rapidos
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Pedidos Rapidos <no-reply@tudominio.com>

# ---- Mercado Pago / cobro de la suscripcion (OPCIONAL) --------------------
# Sin MP_ACCESS_TOKEN + MP_PLAN_PRICE (>0) el cobro online queda deshabilitado.
MP_ACCESS_TOKEN=
MP_PLAN_PRICE=0
MP_PLAN_DAYS=30
MP_PLAN_CURRENCY=ARS
