NODE_ENV=development
API_PORT=3000
WEB_PORT=8080
ADMINER_PORT=8081

POSTGRES_USER=pedidos
POSTGRES_PASSWORD=pedidos
POSTGRES_DB=pedidos
POSTGRES_PORT=5432

DATABASE_URL=postgres://pedidos:pedidos@db:5432/pedidos

JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h

# ---- Super admin (dueno del sistema) --------------------------------------
# Credenciales unicas para entrar a /superAdmin (gestion de clientes, planes y
# vencimientos). NO es un tenant: se valida contra estas variables, no contra la
# base. CAMBIALAS en produccion: si SUPERADMIN_PASSWORD queda en el default, el
# backend NO arranca en NODE_ENV=production.
SUPERADMIN_EMAIL=owner@pedidos.local
SUPERADMIN_PASSWORD=superadmin123
SUPERADMIN_JWT_EXPIRES_IN=8h

# URL publica del frontend (opcional). Si esta seteada, se usa para armar el
# link al detalle del pedido en el mensaje de WhatsApp. Sin esto, se deriva
# del Host del request (sirve para localhost / LAN). Ejemplo:
# PUBLIC_BASE_URL=https://pedidos.mitienda.com
PUBLIC_BASE_URL=

# ---- Email transaccional (SMTP, OPCIONAL) ---------------------------------
# Sin SMTP_HOST/SMTP_USER los emails (reset de password, aviso de fin de prueba,
# bienvenida) se OMITEN sin romper nada. Sirve cualquier proveedor SMTP
# (Brevo, Gmail con app password, Mailgun, ...).
APP_NAME=Pedidos Rapidos
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Pedidos Rapidos <no-reply@tudominio.com>

# ---- Mercado Pago / cobro de la suscripcion (OPCIONAL) --------------------
# Sin MP_ACCESS_TOKEN + MP_PLAN_PRICE (>0) el cobro online queda deshabilitado:
# el boton "Renovar" devuelve un error claro y el webhook no hace nada. El
# access token se obtiene en tu cuenta de Mercado Pago (Tus integraciones).
MP_ACCESS_TOKEN=
MP_PLAN_PRICE=0
MP_PLAN_DAYS=30
MP_PLAN_CURRENCY=ARS
